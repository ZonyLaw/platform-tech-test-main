{
  "extends": ["airbnb", "airbnb/hooks"],
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
     "no-underscore-dangle": "off",
     "import/no-extraneous-dependencies": [
        "error",
        {
            "devDependencies": [
            "**/vite.config.js"
            ]
        }
    ]
  }
}