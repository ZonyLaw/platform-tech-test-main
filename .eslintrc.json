{
  "extends": ["airbnb", "airbnb/hooks"],

  "env": {
    "browser": true,
    "node": true,
    "es2021": true,
    "jest": true
  },

  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },

  "plugins": ["react", "jest"],

  "rules": {
    "react/react-in-jsx-scope": "off",

    "no-underscore-dangle": "off",

    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "always",
        "jsx": "always"
      }
    ],

    "import/no-extraneous-dependencies": [
      "error",
      {
        "devDependencies": [
          "**/vite.config.js",
          "**/*.test.js",
          "**/*.test.jsx"
        ]
      }
    ]
  }
}